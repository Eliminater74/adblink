#!/bin/bash

for file in *.ui; do
    count=0
    base=$(basename "$file" .ui)
    tmpfile=$(mktemp)

    while IFS= read -r line; do
        # Check if the line contains layoutWidget and ensure it's not already prefixed
        if [[ "$line" =~ name=\"layoutWidget ]] && [[ ! "$line" =~ name=\"$base\_layoutWidget ]]; then
            ((count++))
            if (( count == 1 )); then
                newname="${base}_layoutWidget"
            else
                newname="${base}_layoutWidget_$count"
            fi
            # Replace the name inside the line
            newline=$(echo "$line" | sed "s/name=\"layoutWidget[^\"]*\"/name=\"$newname\"/")
            echo "$newline" >> "$tmpfile"
        else
            echo "$line" >> "$tmpfile"
        fi
    done < "$file"

    mv "$tmpfile" "$file"
    echo "Updated $file with $count unique layoutWidget name(s)."
done
