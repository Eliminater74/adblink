#!/bin/bash

# Usage: ./extract_buttons_and_slots.sh file.ui > output.txt

UI_FILE="$1"

if [[ ! -f "$UI_FILE" ]]; then
    echo "Usage: $0 <file.ui>" >&2
    exit 1
fi

echo "Button -> Inferred Auto-Connected Slot"
echo "--------------------------------------"

# Extract buttons and infer their auto-connected slot names
xmllint --xpath '//widget[@class="QPushButton" or @class="QToolButton" or @class="QCommandLinkButton"]' "$UI_FILE" 2>/dev/null \
| grep -oP 'name="\K[^"]+' \
| sort | uniq \
| while read -r btn; do
    echo "$btn -> on_${btn}_clicked()"
done
